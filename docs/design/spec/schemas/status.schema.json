{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peo.dev/schemas/status.schema.json",
  "title": "PEO status (data of peo status [--exposure] --json)",
  "description": "Findings of spec 15 sections 6 and 7. No string carries a value read from a secret file, an agent config or a canary (NF14): evidence holds paths, key names and rules as written. data.inventory is defined by inventory.schema.json.",
  "$defs": {
    "code": {
      "enum": [
        "S-BACKBONE-CONFLICT",
        "S-CATALOG-EXPIRED",
        "S-DEGRADED-INVENTORY",
        "S-DOCS-DRIFT",
        "S-GATE-BYPASS",
        "S-GATE-MATCHER-STALE",
        "S-GATE-OVERRIDE",
        "S-HOOK-FOREIGN",
        "S-HOOK-UNDECLARED",
        "S-INSTALLED-UNCONFIGURED",
        "S-LOCK-MISSING",
        "S-MANAGED-MODIFIED",
        "S-PLUGIN-ERROR",
        "S-PREREQ",
        "S-VERSION-DRIFT",
        "X-CANARY-MISSED",
        "X-CANARY-UNVERIFIABLE",
        "X-COVERAGE-NOT-SHARED",
        "X-DATA-READABLE",
        "X-DATA-STORE",
        "X-HOOK-FAIL-OPEN",
        "X-LITERAL-IN-AGENT-CONFIG",
        "X-MASKING-DUPLICATE",
        "X-MCP-UNEVALUATED",
        "X-NO-SECRET-SCAN",
        "X-SANDBOX-FALLBACK",
        "X-SANDBOX-OFF",
        "X-SECRET-READABLE",
        "X-SECRET-TRACKED"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "^(settings:(managed|managed-other|cli|local|project|user)|settings:managed\\.d(/#[0-9]+)?|mcp:(managed|local|project|user)|claude|plugin:#[0-9]+|plugin:\\*)$"
    },
    "finding": {
      "type": "object",
      "required": [
        "code",
        "confidence",
        "evidence",
        "message",
        "severity",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "status": {
          "enum": [
            "applied",
            "skipped"
          ]
        },
        "confidence": {
          "enum": [
            "fact",
            "likely"
          ]
        },
        "message": {
          "type": "string",
          "description": "One line. Never says protected (spec 15 section 7)."
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Source ids, project paths, key names and Read(...) rules only (NF14)."
        },
        "path": {
          "type": "string",
          "description": "Project-relative path, / separator, no trailing / (a folder is marked by the code, not the path). For a symbolic link, the link path, never its target."
        },
        "source": {
          "$ref": "#/$defs/source_id"
        },
        "rule": {
          "type": "string",
          "description": "Read(...) permission rule as written in the source (spec 14 section 3.5; NF14)."
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "suggested_rule": {
          "type": "string",
          "pattern": "^Read\\(\\./[A-Za-z0-9._@+/-]+?(/\\*\\*)?\\)$",
          "description": "Read(./<exact path>) or Read(./<folder>/**); omitted when the path holds a character outside the literal set of spec 14 section 3.5 (spec 15 section 7.1)."
        },
        "plugin_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reason": {
      "enum": [
        "symlink-outside",
        "symlink",
        "untested-platform",
        "untested-version",
        "contradictory-observations",
        "untested-scope",
        "untested-form",
        "case-only",
        "bare-tool",
        "source-unreadable",
        "nested-settings"
      ],
      "description": "First applicable in this order (spec 14 section 3.5); the others go to evidence. nested-settings is set by the caller, never by covers() (spec 15 section 7.1)."
    }
  },
  "type": "object",
  "required": [
    "findings",
    "inventory",
    "limits",
    "rules_evaluated"
  ],
  "additionalProperties": false,
  "properties": {
    "inventory": {
      "type": "object",
      "description": "inventory.schema.json (spec 14 section 3.2); validated separately against that schema (A11.5)."
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "description": "S-* findings, sorted by code, path, source, plugin_index, index, evidence."
    },
    "rules_evaluated": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/code"
      },
      "description": "Sorted codes evaluated in this run: the rule set of this PEO version (Livraison column of spec 15)."
    },
    "limits": {
      "type": "array",
      "items": {
        "enum": [
          "L-CASE-SENSITIVITY",
          "L-CLAUDE-NEWER",
          "L-DISCOVERY-DEPTH",
          "L-GREP-GLOB",
          "L-HTTP-HOOK",
          "L-LAUNCH-ROOT",
          "L-MCP-APPROVAL",
          "L-MCP-LOCAL-USER",
          "L-NESTED-SETTINGS",
          "L-SERVER-MANAGED",
          "L-SETTINGS-CLI",
          "L-SETTINGS-MANAGED-OTHER",
          "L-SYMLINK-DIR"
        ]
      },
      "description": "Sorted; what this run could not see (spec 15 section 7.4)."
    },
    "exposure": {
      "type": "object",
      "required": [
        "audited",
        "findings",
        "linked_dirs"
      ],
      "additionalProperties": false,
      "properties": {
        "audited": {
          "type": "array",
          "description": "Every path of sensitive.secret_files, data_dumps and log_dirs with its covers() verdict, sorted by path (spec 15 section 7.3).",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "path",
              "reason",
              "rule",
              "source",
              "verdict"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "data_dump",
                  "log_dir",
                  "secret_file"
                ]
              },
              "verdict": {
                "enum": [
                  "covered",
                  "not_covered",
                  "undecidable"
                ]
              },
              "reason": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/reason"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rule": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/source_id"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          },
          "description": "X-* findings, same order."
        },
        "linked_dirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "sensitive.walk.linked_dirs: linked folders not walked (L-SYMLINK-DIR)."
        }
      },
      "description": "Present with --exposure. canary sits beside it from R4.1, when the schema is extended (spec 15 section 7.3)."
    }
  }
}
